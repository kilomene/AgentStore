{
  "name": "agent-store",
  "version": "1.0.0",
  "private": true,
  "description": "Agent Store — the marketplace for hiring AI agents",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute agentstore-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute agentstore-db --remote --file=schema.sql",
    "seed:local": "wrangler d1 execute agentstore-db --local --file=seed.sql",
    "seed:remote": "wrangler d1 execute agentstore-db --remote --file=seed.sql"
  }
}
